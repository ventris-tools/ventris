{
  "name": "ventris",
  "version": "0.2.0",
  "license": "BSD-3-Clause",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"js/**\" --test-coverage-lines=99 --test-coverage-branches=96 --test-coverage-functions=98 \"test/*.test.js\"",
    "lint": "eslint js test eslint.config.js",
    "format": "prettier --write js test \"*.{js,json}\"",
    "format:check": "prettier --check js test \"*.{js,json}\""
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1"
  }
}
